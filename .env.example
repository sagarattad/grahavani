# Copy to .env for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for production.

# Supabase → Project Settings → Database → Connection string
# App: pooled "Transaction" connection (port 6543)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: "Session" pooler or direct connection (port 5432)
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# OpenAI (server only). Also set a hard monthly budget in the OpenAI dashboard.
OPENAI_API_KEY=""
# Optional: Google Gemini (server only), only if a model in config/ai.ts starts with "gemini"
GOOGLE_API_KEY=""

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Private mode: only these Google accounts may use the site (comma-separated).
# Leave empty for an open site. Needs the two Google values above.
ALLOWED_EMAILS=""

# Cloudflare Turnstile. These two are Cloudflare's always-pass TEST keys (the
# widget then shows "For testing only"); use real keys on a public site. In
# private mode (ALLOWED_EMAILS set) leave both empty: no widget, no check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Any long random strings
CRON_SECRET=""
IP_HASH_SALT=""

# App-side monthly AI budget guard (USD, estimated from token counts)
AI_MONTHLY_BUDGET_USD="12"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
